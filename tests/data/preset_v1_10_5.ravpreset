RAVPRESET 1
preset id=user/stairs-heavy version=3 name=Stairs (heavy boots)
options sensitivity=0.2 edge_ms=0 smooth_ms=6
analyse floor_pct=2 pos_frac=0.25 speed_pct=25 margin_ratio=0.5 onset_frac=0.1 per_bone_floor=1
block color=#5F9EDD hold_ms=12 cooldown_ms=250 offset_ms=-4.5 land=cross marker=Footstep L
cond q=point bones=role:left_heel comb=single ref=floor meas=position axis=vertical dir=below thr=0.0437 margin=0.025 fixed=1
strength q=point bones=role:left_heel comb=single ref=floor meas=speed axis=vertical signed=1 sign=-1 window_ms=100
block color=#DD9E5F hold_ms=0 cooldown_ms=250 offset_ms=0 land=peak:1:min marker=Footstep R
cond q=point bones=role:right_heel comb=single ref=floor meas=position axis=vertical dir=below thr=0.0412 margin=0.025 fixed=0
cond q=angle bones=role:right_knee comb=single ref=floor meas=speed axis=vertical dir=above thr=120 margin=30 fixed=0
strength q=point bones=role:right_heel comb=single ref=floor meas=speed axis=vertical signed=1 sign=-1 window_ms=100
block on=0 color=#7FC97F hold_ms=0 cooldown_ms=300 offset_ms=0 land=cross marker=Toe Off L
cond q=rot bones=role:left_toe comb=single ref=parent meas=speed axis=x dir=above thr=250 margin=50 fixed=0
cond q=yaw bones=role:left_heel,role:left_toe comb=single ref=floor meas=position axis=vertical dir=above thr=10 margin=0 fixed=0
cond q=point bones=bone:mixamorig:Left%20Toe_End comb=single ref=bones ref_bones=role:hips ref_comb=lowest meas=position axis=horizontal dir=above thr=0.3 margin=0.05 fixed=0
