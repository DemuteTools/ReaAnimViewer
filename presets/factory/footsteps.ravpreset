RAVPRESET 1
preset id=factory/footsteps version=1 name=Footsteps
options sensitivity=0 edge_ms=0 smooth_ms=8
analyse floor_pct=2 pos_frac=0.4 speed_pct=30 margin_ratio=0.5 onset_frac=0.3 per_bone_floor=1
block color=#5F9EDD hold_ms=0 cooldown_ms=250 offset_ms=0 land=peak:1:max marker=Footstep L
cond q=point bones=role:left_heel,role:left_toe comb=lowest ref=floor meas=position axis=vertical dir=below thr=0.05 margin=0.025 fixed=0
cond q=joint bones=role:left_up_leg,role:left_knee,role:left_heel comb=single ref=floor meas=speed axis=vertical signed=1 dir=above thr=50 margin=25 fixed=0
cond q=yaw bones=role:left_heel,role:left_toe comb=single ref=floor meas=speed axis=vertical dir=below thr=800 margin=0 fixed=1
strength q=point bones=role:left_heel,role:left_toe comb=lowest ref=floor meas=speed axis=vertical signed=1 sign=-1 window_ms=100
block color=#DD9E5F hold_ms=0 cooldown_ms=250 offset_ms=0 land=peak:1:max marker=Footstep R
cond q=point bones=role:right_heel,role:right_toe comb=lowest ref=floor meas=position axis=vertical dir=below thr=0.05 margin=0.025 fixed=0
cond q=joint bones=role:right_up_leg,role:right_knee,role:right_heel comb=single ref=floor meas=speed axis=vertical signed=1 dir=above thr=50 margin=25 fixed=0
cond q=yaw bones=role:right_heel,role:right_toe comb=single ref=floor meas=speed axis=vertical dir=below thr=800 margin=0 fixed=1
strength q=point bones=role:right_heel,role:right_toe comb=lowest ref=floor meas=speed axis=vertical signed=1 sign=-1 window_ms=100
